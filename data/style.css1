* {
    box-sizing: border-box;
    user-select: none;
    margin: 0;
    padding: 0;
}

html, body {
    width: 100vw;
    height: 100vh;
    overflow: hidden;          /* Без прокрутки */
    background: #1a1a1a;
    color: #fff;
    font-family: 'Arial', sans-serif;
}

body {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

/* ============================================ */
/* 1. ВЕРХНЕЕ ОКНО (фиксированная высота)       */
/* ============================================ */
.window-header {
    flex-shrink: 0;           /* Не сжимается */
    height: 20px;
    border-bottom: 1px solid #333;
}

.mode-bar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
    transition: background-color 0.3s;
}

.mode0 { background: #0066cc; }
.mode1-green { background: #00aa00; }
.mode1-yellow { background: #cccc00; color: #000; }
.mode1-red { background: #cc0000; }

/* ============================================ */
/* 2. ОСНОВНАЯ ЧАСТЬ (левая панель + график)    */
/* ============================================ */
.main-area {
    flex: 1;                   /* Занимает всё оставшееся пространство */
    display: flex;
    flex-direction: row;
    min-height: 0;            /* Важно для корректного сжатия */
}

/* ----- Левая панель (фиксированная ширина) ----- */
.window-left {
    flex-shrink: 0;           /* Не сжимается */
    width: 90px;
    border-right: 1px solid #333;
    overflow-y: auto;         /* Если содержимое не влезает — появится скролл */
    background: #1a1a1a;
}

.left-panel {
    width: 100%;
    padding: 8px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

/* ----- График (занимает всё оставшееся место) ----- */
.window-graph {
    flex: 1;                   /* Растягивается на всю ширину */
    background: #1a1a1a;
    min-height: 0;
}

#tempChart {
    width: 100%;
    height: 100%;
    touch-action: none;        /* Запрещаем браузеру перехватывать жесты */
}

/* ============================================ */
/* 3. НИЖНЕЕ ОКНО (отладка)                    */
/* ============================================ */
.window-debug {
    flex-shrink: 0;           /* Не сжимается */
    height: 30px;
    border-top: 1px solid #333;
    background: #1a1a1a;
}

.debug-bar {
    width: 100%;
    height: 100%;
    padding: 0 8px;
    font-family: monospace;
    font-size: 10px;
    color: #aaa;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.debug-bar span {
    white-space: nowrap;
}

.debug-value {
    color: #ffaa00;
    font-weight: bold;
}

/* ============================================ */
/* ЭЛЕМЕНТЫ ВНУТРИ ЛЕВОЙ ПАНЕЛИ                */
/* ============================================ */

/* Карточки температур */
.temp-card {
    width: 80px;
    height: 25px;
    background: #2a2a2a;
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 1px;
}

/* Кнопки масштаба */
.scale-btn {
    width: 80px;
    height: 25px;
    background: #333;
    border: none;
    color: white;
    font-size: 14px;
    border-radius: 2px;
    cursor: pointer;
    margin: 1px 0;
    transition: background-color 0.2s;
    outline: none;
}
.scale-btn:hover { background: #3a3a3a; }
.scale-btn:active { background: #4a4a4a; }
.scale-btn.active { background: #0066cc !important; }

/* Wi-Fi панель */
.panel-wifi {
    width: 80px;
    background: #2a2a2a;
    border-radius: 4px;
    padding: 4px 0;
    margin-top: 4px;
    border-top: 1px solid #444;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

.wifi-status, .wifi-ip {
    width: 100%;
    text-align: center;
    font-size: 8px;
    color: #aaa;
}
#wifiModeValue { font-weight: bold; }
#wifiIPValue { color: #00FF00; }

.wifi-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 2px 0;
}

.wifi-form input {
    width: 70px;
    background: #333;
    border: 1px solid #555;
    color: white;
    padding: 2px;
    border-radius: 3px;
    font-size: 9px;
    text-align: center;
}
.wifi-form input::placeholder {
    color: #666;
    font-size: 8px;
}

.wifi-btn {
    width: 70px;
    height: 18px;
    background: #0066cc;
    border: none;
    color: white;
    font-size: 9px;
    border-radius: 3px;
    cursor: pointer;
    transition: background-color 0.2s;
    outline: none;
}
.wifi-btn:hover { background: #0077ee; }
.wifi-btn:active { background: #0055aa; }
.wifi-btn-ap { background: #cc6600; }
.wifi-btn-ap:hover { background: #ee7700; }
.wifi-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Нижний блок (поля ввода) */
.panel-bottom {
    margin-top: 4px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    border-top: 1px solid #444;
    padding-top: 4px;
}

.panel-range-item {
    width: 80px;
    background: #2a2a2a;
    border-radius: 4px;
    padding: 2px 0;
    text-align: center;
}
.panel-range-item label {
    color: #aaa;
    font-size: 9px;
    display: block;
}
.panel-range-item input {
    width: 70px;
    background: #333;
    border: 1px solid #555;
    color: white;
    padding: 2px;
    border-radius: 3px;
    font-size: 11px;
    text-align: center;
}

/* Убираем стрелочки у числовых полей */
input[type=number]::-webkit-outer-spin-button,
input[type=number]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}
input[type=number] {
    -moz-appearance: textfield;
    appearance: textfield;
}

/* Статус подключения */
.panel-status {
    width: 80px;
    background: #2a2a2a;
    border-radius: 4px;
    padding: 4px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
}
.panel-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transition: all 0.3s;
}

@keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.1); }
    100% { opacity: 1; transform: scale(1); }
}

.panel-status-dot.online {
    background: #4CAF50;
    box-shadow: 0 0 4px #4CAF50;
    animation: none;
}
.panel-status-text.online { color: #4CAF50; animation: none; }

.panel-status-dot.offline-yellow {
    background: #ffaa00;
    box-shadow: 0 0 4px #ffaa00;
    animation: pulse 1.5s infinite;
}
.panel-status-text.offline-yellow {
    color: #ffaa00;
    animation: pulse 1.5s infinite;
}

.panel-status-dot.offline {
    background: #f44336;
    box-shadow: 0 0 4px #f44336;
    animation: pulse 1.5s infinite;
}
.panel-status-text.offline {
    color: #f44336;
    animation: pulse 1.5s infinite;
}
.panel-status-text {
    font-size: 10px;
    font-weight: bold;
}